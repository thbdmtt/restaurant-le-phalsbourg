NEXT_PUBLIC_SITE_URL=https://www.restaurantlephalsbourg.com
# Published CSV URLs; the unqualified name is an alias for the food menu.
GOOGLE_SHEET_CSV_URL=
GOOGLE_SHEET_MENU_CSV_URL=
GOOGLE_SHEET_WINES_CSV_URL=
# Alternative: Google Sheets v4. An ID requires credentials or an API key for a public sheet.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_MENU_RANGE=Menu!A:Z
GOOGLE_SHEET_WINES_RANGE=Wines!A:Z
GOOGLE_SHEETS_API_KEY=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Persistent writable directory; mount a persistent volume in production.
MENU_CACHE_DIR=.menu-cache
# Optional shared persistence for serverless/multi-instance hosting (Upstash Redis REST).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Verified publication details, completed by the restaurant before going live.
LEGAL_COMPANY_NAME=
LEGAL_COMPANY_REGISTRATION=
LEGAL_PUBLICATION_DIRECTOR=
LEGAL_HOST_NAME=
LEGAL_HOST_ADDRESS=
LEGAL_HOST_PHONE=
